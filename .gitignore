# >>> sprint-loops >>>
# Ephemeral sprint working memory — regenerable; the real outcome lives in the
# per-task git commits + decisions.md. KEEP tracked (long-term memory the
# protocol depends on): decisions.md, agent-tasks/, confidence.txt.
sprints/
*.tmp
# <<< sprint-loops <<<

# Rust
target/

# Stray build artifacts / scratch outputs (sprint 72 cleanup). Compiled
# binaries and debug symbols never belong in source; the *.txt/*.json below
# are one-off manual-test scratch. `confidence.txt` is protocol state and is
# force-kept via the sprint-loops allowlist above, so it is unaffected.
*.exe
*.pdb
/payload.json
/result.txt
/ferric-mock.txt

# JetBrains IDE project config (local to each dev's machine).
.idea/

# Local model weights (GGUF / safetensors) — 16 GB, never committed.
models/

# E2E run artifacts and benchmark logs.
e2e_workspace*/
e2e_test_log*.txt
e2e_log_*.txt
*.log

# Runtime artifacts: per-session traces + the `ferric server` runfile, and
# toolbench reports written by --report (single + fleet sweeps).
.ferric/
/report*.md
/report*.jsonl
/fleet*.md
/fleet*.jsonl
/toolbench_*.md
/toolbench_*.jsonl
/ring*.md
/ring*.jsonl
/calib*.md
/calib*.jsonl

# Local compose overrides. MODELS_PATH is machine-specific — this file was
# TRACKED and pinned to a NAS drive (`Y:\Models\gguf`), so it overrode the
# compose default on every checkout and broke `docker compose up` anywhere that
# drive was not mapped. Found in sprint 96 as the reason the stack could not
# start. The default now points at the shared suite store; override here only if
# yours lives elsewhere.
docker/.env
