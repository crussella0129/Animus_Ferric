
# Rust
target/

# Stray build artifacts / scratch outputs (sprint 72 cleanup). Compiled
# binaries and debug symbols never belong in source; the *.txt/*.json below
# are one-off manual-test scratch. Sprint Loop confidence state lives at
# `docs/work/confidence.txt` and is tracked explicitly.
*.exe
*.pdb
/payload.json
/result.txt
/ferric-mock.txt

# JetBrains IDE project config (local to each dev's machine).
.idea/

# One-off scratch scripts (sprint 105). Kept on disk, not shipped.
scratch/

# Benchmark OUTPUT — one machine's run log and its measured model profiles.
# `model_profiles.json` is not merely noise: ADR-029 reads it back at runtime
# and a stored `measured_level` overrides the parameter-count prior in BOTH
# directions, so a tracked copy would hand every fresh checkout a tier this
# project measured on different hardware, at a quantization the record does not
# pin. A miss is a documented safe no-op, so an absent file is the correct
# default for a new user. `model_profiles.example.json` is tracked as a shape
# reference; run `ferric bench` to produce your own.
/benchmarks/*
!/benchmarks/model_profiles.example.json

# Local model weights (GGUF / safetensors) — 16 GB, never committed.
models/

# E2E run artifacts and benchmark logs.
e2e_workspace*/
e2e_test_log*.txt
e2e_log_*.txt
*.log

# Runtime artifacts: per-session traces + the `ferric server` runfile, and
# toolbench reports written by --report (single + fleet sweeps).
.ferric/
/report*.md
/report*.jsonl
/fleet*.md
/fleet*.jsonl
/toolbench_*.md
/toolbench_*.jsonl
/ring*.md
/ring*.jsonl
/calib*.md
/calib*.jsonl

# Local compose overrides. MODELS_PATH is machine-specific — this file was
# TRACKED and pinned to a NAS drive (`Y:\Models\gguf`), so it overrode the
# compose default on every checkout and broke `docker compose up` anywhere that
# drive was not mapped. Found in sprint 96 as the reason the stack could not
# start. The default now points at the shared suite store; override here only if
# yours lives elsewhere.
docker/.env

# mdBook build output (source is docs/ + book.toml)
/book

# Local assistant session state.
/.claude/
# >>> sprint-loops >>>
